# LLM service (OpenAI-compatible endpoint)
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.2
ITEM_MODEL=qwen-flash
VL_MODEL=qwen3-vl-flash

# MinerU cloud API
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=

# Local embedding and reranker models
BGE_M3_PATH=./models/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0
BGE_RERANKER_V2_M3=./models/bge-reranker-v2-m3
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0
BGE_RERANKER_MAX_LENGTH=2048
BGE_RERANKER_BATCH_SIZE=16
BGE_RERANKER_NORMALIZE=1

# Databases and object storage
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=zhiku
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=zhiku
MINIO_IMG_DIR=images

# Import pipeline
DATA_BASED_ROOT_DIR=./output/data
MAX_CONTENT_LENGTH=1000
MIN_CONTENT_LENGTH=100
ITEM_NAME_CHUNK_K=5
ITEM_NAME_CHUNK_SIZE=1000
IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.gif,.bmp,.webp

# Optional MCP search (provider-specific credentials)
MCP_ZHIPU_BASE_URL=
MCP_DASHSCOPE_BASE_URL=
MCP_ZHIPU_API_KEY=
